# ─── EXISTING (SINGLE TENANT) ────────────────────────────────────────────────

# Existing studio database (becomes the first tenant DB)
DATABASE_URL="postgresql://postgres:password@localhost:5432/urumi_designer_studio"

# JWT secret for session tokens
JWT_SECRET="your-super-secret-jwt-key-change-in-production"

# Cloudinary (existing Urumi studio)
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# WhatsApp notifications
NEXT_PUBLIC_ENABLE_WHATSAPP_NOTIFICATIONS="false"


# ─── NEW: MULTI-TENANT ───────────────────────────────────────────────────────

# Master database (stores all studio metadata)
# Create a separate PostgreSQL database for this
MASTER_DATABASE_URL="postgresql://postgres:password@localhost:5432/urumi_master_db"

# Base URL for building tenant DB connection strings
# Same host/user/password as DATABASE_URL but without the DB name
# The app will append the tenant database name automatically
DATABASE_BASE_URL="postgresql://postgres:password@localhost:5432"

# AES-256-GCM encryption key for storing Cloudinary API secrets
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="your-64-character-hex-string-here"

# Platform domain(s) — these bypass tenant resolution (comma-separated)
# Add your own platform/landing page domain here
PLATFORM_DOMAINS="localhost,127.0.0.1,yourplatform.com"

# CORS allowed origins
ALLOWED_ORIGINS=""

# Super admin credentials (used by setup-master-db.ts script)
ADMIN_EMAIL="admin@yourplatform.com"
ADMIN_PASSWORD="change-this-in-production"

# For seeding the first studio (Urumi)
URUMI_DOMAIN="localhost"
URUMI_EMAIL="admin@urumi.com"
